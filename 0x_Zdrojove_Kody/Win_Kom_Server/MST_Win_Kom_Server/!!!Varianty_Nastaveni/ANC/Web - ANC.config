    <!-- Timeout cekani na dokonceni akce po vlozeni dat v sekundach
    Defaultni timeout 30s
    Jestlize se nastavi na 0, pak se ceka na dokonceni operace nekonecne(pozor muze vest k problemum)
    Poznamka: !Pokud je vyzadovano synchronni volani (terminal ma mit odpoved o provedeni akce), pak neni vhodne nastavovat vetsi timeout, nez je nastaven timeout na terminalu pro cekani na odpoved serveru!
    -->
    <add key="AfterDataProcessed_Action_CommandTimeout" value="30" />
    <!-- Timeout cekani na dokonceni akce pred pripravou dat pro terminaly v sekundach
