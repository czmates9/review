		Configuration[label="Configuration.asmx.cs", tooltip="Configuration class", URL="\ref Configuration.asmx.cs"];
		Ciselnik[label="Ciselnik.asmx.cs", tooltip="Ciselnik class", URL="\ref Ciselnik.asmx.cs"];


	Doxygen -> top [color="green"];

	edge[color="goldenrod2"];
		Default -> top;
		
		Upload-> Default;
		Login-> Default;
		Vydej-> Default;
        VydejTest-> Default;
        Ukolovani-> Default;
        TiskTest-> Default;
        Tisk-> Default;
        Test-> Default;
