		PrijemTest[label="PrijemTest.asmx.cs", tooltip="PrijemTest class", URL="\ref PrijemTest.asmx.cs"];
		Lokace[label="Lokace.asmx.cs", tooltip="Lokace class", URL="\ref Lokace.asmx.cs"];
		LoginService[label="LoginService.asmx.cs", tooltip="LoginService class", URL="\ref LoginService.asmx.cs"];
		Login[label="Login.aspx.cs", tooltip="Login class", URL="\ref Login.aspx.cs"];
