digraph ProjectHierarchy
	{

    label="Server Projekt";
    labelloc="t";

	graph[size="11,11"];
	rankdir="RL";
	node[color="gray25", fontname="Helvetica", shape="Mrecord", style="solid"];
		top[label="MSTW_Server project 2019", URL="\ref index"];

	node[color="green", fontname="Helvetica", shape="Mrecord", style="dotted"];
		Doxygen[label="Doxygen\ndocumentation", tooltip="Doxygen documentation", URL="\ref doc"];


	node[color="goldenrod2", fontname="Helvetica", shape="Mrecord", style="dotted"];
		Default[label="Default.aspx.cs", URL="\ref Default.aspx.cs"];
		WebService[label="WebService"];
		Page[label="Page"];

	node[color="goldenrod2", fontname="Helvetica", shape="Mrecord", style="solid"];
		Vydej[label="Vydej.asmx.cs", tooltip="Vydej class", URL="\ref Vydej.asmx.cs"];
