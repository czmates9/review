<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MP_Main.master.cs" Inherits="Fask.MST_W_Server.MP_Main" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>MST Konfiguračný server</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" ShowStartingNode="False" />

    <form id="form1" runat="server">

        <div id="FakeDiv"></div>

        <nav id="NavHead" class="navbar navbar-inverse navbar-fixed-top">
            <div class="container-fluid">
                <div class="navbar-header">
                    <h1 class="h1"><asp:Label ID="NadpisStranky" runat="server" meta:resourcekey="NadpisStranky" ></asp:Label></h1>
                </div>
                <div>
                    <div class="collapse navbar-collapse" id="myNavbar">
                        <ul class="nav navbar-nav">
                            <li><a href="<%=Page.ResolveUrl("~/Default.aspx")%>" ><asp:Label ID="Menu_Domu" runat="server" meta:resourcekey="Menu_Domu" ></asp:Label></a></li>
                            <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_Agendy.aspx")%>"><asp:Label ID="Menu_Agendy" runat="server" meta:resourcekey="Menu_Agendy" ></asp:Label></a></li>
                            <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_WebConfig.aspx")%>"><asp:Label ID="Menu_WebConfig" runat="server" meta:resourcekey="Menu_WebConfig" ></asp:Label></a></li>

                            <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown" href="#">Provider <span class="caret"></span></a>
                                <ul class="dropdown-menu">
                                    <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_ProviderPohodaXML.aspx")%>"><asp:Label ID="Menu_Provider_POHODA" runat="server" meta:resourcekey="Menu_Provider_POHODA" ></asp:Label></a></li>
                                    <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_ProviderSql.aspx")%>"><asp:Label ID="Menu_Provider_SQL" runat="server" meta:resourcekey="Menu_Provider_SQL" ></asp:Label></a></li>
                                    <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_ProviderABRACarpServis.aspx")%>"><asp:Label ID="Menu_Provider_ABRACarpServis" runat="server" meta:resourcekey="Menu_Provider_ABRACarpServis" ></asp:Label></a></li>
                                    <li><a href="<%=Page.ResolveUrl("~/Konfigurace/Stranky/Konfigurace_ProviderABRA_SAB.aspx")%>"><asp:Label ID="Menu_Provider_ABRA_SAB" runat="server" meta:resourcekey="Menu_Provider_ABRA_SAB" ></asp:Label></a></li>
                                </ul>
                            </li>
                            <li><a href="<%=Page.ResolveUrl("~/Server.aspx")%>" ><asp:Label ID="Menu_Server" runat="server" meta:resourcekey="Menu_Server" ></asp:Label></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>


        <article style="width: 100%">
            <div id="centrovac">
                <section>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </section>
                <div class="cistic"></div>
            </div>
        </article>



        <footer class="Paticka">

            <div class="UserDiv">
                <asp:Label class="User" ID="UzivatelText" runat="server" meta:resourcekey="UzivatelText" ></asp:Label>
                <span class="User">
                    <asp:Label ID="lblUser" runat="server" Text="-"></asp:Label><br />
                </span>
                <span class="User">
                    <asp:LinkButton ID="LinkLogOut" runat="server" OnClick="LinkLogOut_Click" meta:resourcekey="LinkLogOut"></asp:LinkButton>
                </span>
            </div>
            <asp:Label class="Copy" ID="Creator" runat="server" meta:resourcekey="Creator" ></asp:Label>
        </footer>


        <asp:ContentPlaceHolder ID="ScriptyJS" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
