<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#fff">
  <!--Tady v temto miste je linearlayout ktery obsahuje potrebne zobrazene componenty-->
  <ScrollView
      android:layout_width="fill_parent"
      android:layout_height="fill_parent"
      android:background="#fff">
    <TableLayout
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_TerminalID"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_TerminalID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="number" />
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_ServerAdresa"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_Adresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="text" />
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_TimeOut"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_TimeOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="number" />
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
            <CheckBox
                android:text="@string/Config_isHTTPS"
                android:id="@+id/Config_isHTTPS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_API_Konstanta"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_API_Konst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="text" />
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_API_Autorizace"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_API_Auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="text" />
      </TableRow>
                  <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:padding="8dp"
            android:text="@string/Config_FormatCisel"
            android:textColor="#000000"
            android:textSize="16dp" />
      </TableRow>
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
        <EditText
            android:id="@+id/Config_ForCisel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dp"
            android:layout_marginRight="20.0dp"
            android:gravity="left"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="16dp"
            android:inputType="text" />
      </TableRow>
    </TableLayout>
  </ScrollView>
  <!-- Levý navigační panel -->
</LinearLayout>