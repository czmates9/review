<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#c9c9c9"
    >
        <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".166666666666666666"
        android:background="@drawable/border_PPP"
        >
    <TextView
    android:id="@+id/textView_PPP_popis"
    android:text="@string/Def_Text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:layout_weight=".50"
    android:layout_margin="1dp"
    android:textColor="#000"
    android:textSize="20px"
    />  

    <EditText
    android:id="@+id/editText_PPP_Kod"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight=".50"
    android:hint="@string/text_HIN"
    android:inputType="text"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    />
      </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".0833333333333"
        >
         <Button
            android:text="@string/PPP_OK"
            android:id="@+id/button_PPP_OK"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginBottom="10px"
            android:layout_marginTop="10px"
            android:layout_weight=".50"
            android:background="@drawable/border_ppp_btn_ok"
            android:layout_gravity="center"
            />
        <Button
            android:text="@string/PPP_Storno"
            android:id="@+id/button_PPP_Storno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginBottom="10px"
            android:layout_marginTop="10px"
            android:layout_weight=".50"
            android:background="@drawable/border_ppp_btn_storno"
            android:layout_gravity="center"
            />
    </LinearLayout>


    <TextView
        android:id="@+id/textView_PPP_ITEMDESC"
        android:text="@string/Def_Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_weight=".25"
        android:background="@drawable/border_ppp"
        android:layout_margin="1dp"
        android:textColor="#000"
        android:textSize="30px"
        />

        <TextView
        android:id="@+id/textView_PPP_ITEMCODE"
        android:text="@string/text_ITEMCODE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:layout_weight=".0833333333333"
        android:background="@drawable/border_ppp"
        android:layout_margin="1dp"
        android:textColor="#000"
        android:textSize="20px"
        />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".0833333333333"
        >
        <TextView
            android:text="@string/text_CZ_CarKod"
            android:id="@+id/textview_PPP_11"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
        <TextView
            android:text="@string/text_ITEMNMBR"
