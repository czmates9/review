            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".0833333333333"
        >
        <TextView
            android:text="@string/text_LOCNCODE"
            android:id="@+id/textview_PPP_31"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
        <TextView
            android:text="@string/text_QTYSHPPD"
            android:id="@+id/textview_PPP_32"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".0833333333333"
        >
        <TextView
            android:text="@string/text_CZ_SerNum_Track"
            android:id="@+id/textview_PPP_41"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
        <TextView
            android:text="@string/text_WEIGHT"
            android:id="@+id/textview_PPP_42"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".0833333333333"
        >
        <TextView
            android:text="@string/text_PRICE"
            android:id="@+id/textview_PPP_51"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
        <TextView
            android:text="@string/text_TAXRATE"
            android:id="@+id/textview_PPP_52"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".50"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/border_ppp"
            android:layout_margin="1dp"
            android:textColor="#000"
            android:textSize="20px"
            />
    </LinearLayout>
</LinearLayout>
