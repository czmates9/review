<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#fff">
  <!--Tady v temto miste je linearlayout ktery obsahuje potrebne zobrazene componenty-->
  <ScrollView
      android:layout_width="fill_parent"
      android:layout_height="fill_parent"
      android:background="#fff">
    <TableLayout
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">
      <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
            <CheckBox
                android:text="@string/Config_Zebra"
                android:id="@+id/Config_Zebra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
      </TableRow>
      <View
          android:layout_height="2dip"
          android:background="#71777F"
          android:layout_width="match_parent" />
   <TableRow
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginTop="4dp"
          android:background="#FFFFFF">
            <CheckBox
                android:text="@string/Config_ZXing"
                android:id="@+id/Config_ZXing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
      </TableRow>
    </TableLayout>
  </ScrollView>
  <!-- Levý navigační panel -->
</LinearLayout>