
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/TypeCode"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                />
            <TextView
                android:id="@+id/ParKod_UkazKod_txtTypKod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#368DEB"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/ExampleText"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                />
                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/Code"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                />
                <TextView
                android:id="@+id/ParKod_UkazKod_txtKod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#368DEB"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/ExampleText"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                />
                <TextView
                android:layout_width="match_parent"
                android:layout_height="10px"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                android:background="@android:color/white"
                />
                <TextView
                android:id="@+id/ParKod_UkazKod_Poznamka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#368DEB"
                android:textStyle="bold"
                android:textSize="20sp"
                android:text="@string/ExampleText"
                android:gravity="left"
                android:paddingLeft="50px"
                android:paddingRight="50px"
                android:paddingTop="20px"
                android:paddingBottom="20px"
                />
                        <ListView
                android:id="@+id/ParKod_UkazKod_ListHodnot"
                android:layout_width="match_parent"
                android:layout_height="600px"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>