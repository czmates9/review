<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
     android:background="#c9c9c9"
    android:weightSum="100"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/InputQuantity_app_bar_main">
    <TextView
        android:text="@string/InputQuantity_Label_QTY"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/InputQuantity_txt_QTY"
        android:textSize="50px"
        android:textAlignment="center"
        />
        <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/InputQuantity_edittxt_QTY"
        android:nextFocusDown="@id/InputQuantity_btn_OK"
        android:nextFocusLeft="@id/InputQuantity_edittxt_QTY"
        android:nextFocusUp="@id/InputQuantity_edittxt_QTY"
        android:nextFocusRight="@id/InputQuantity_edittxt_QTY"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="50px"
        android:layout_marginTop="50px"
        android:textColor="#000000"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="70px"
        android:singleLine="true"
        android:inputType="text" 
        android:paddingBottom="50px"
        android:paddingTop="50px"
        android:hint="@string/InputQuantity_hint"
        />
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="100"
         android:background="#c8e7ff"
        >
        <Button
        android:text="@string/InputQuantity_Storno"    
        android:nextFocusDown="@id/InputQuantity_btn_Storno"
        android:nextFocusLeft="@id/InputQuantity_btn_Storno"
        android:nextFocusUp="@id/InputQuantity_edittxt_QTY"
        android:nextFocusRight="@id/InputQuantity_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/InputQuantity_btn_Storno"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        <Button
        android:text="@string/InputQuantity_OK"    
        android:nextFocusDown="@id/InputQuantity_btn_OK"
        android:nextFocusLeft="@id/InputQuantity_btn_Storno"
        android:nextFocusUp="@id/InputQuantity_edittxt_QTY"
        android:nextFocusRight="@id/InputQuantity_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/InputQuantity_btn_OK"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        </LinearLayout>
</LinearLayout>