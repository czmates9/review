<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/MainLogin_app_bar_main">
            <TextView
                android:text="@string/Main_Login_Login"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/txt_Login_ID_V2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#368DEB"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="25sp"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/edittext_Login_ID_V2"
                android:nextFocusDown="@id/edittext_Login_PWD_V2"
                android:nextFocusLeft="@id/edittext_Login_ID_V2"
                android:nextFocusUp="@id/edittext_Login_ID_V2"
                android:nextFocusRight="@id/edittext_Login_ID_V2"
                android:layout_marginLeft="20.0dp"
                android:layout_marginRight="20dp"
                android:textColor="#000000"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="25sp"
                android:singleLine="true"
                android:inputType="text"
        />
            <TextView
                android:text="@string/Main_Login_Password"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/txt_Login_PWD_V2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#368DEB"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="25sp" />
            <EditText
                android:id="@+id/edittext_Login_PWD_V2"
                android:nextFocusDown="@id/btn_Login_OK_V2"
                android:nextFocusLeft="@id/edittext_Login_PWD_V2"
                android:nextFocusUp="@id/edittext_Login_ID_V2"
                android:nextFocusRight="@id/edittext_Login_PWD_V2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20.0dp"
                android:layout_marginRight="20dp"
                android:textColor="#000000"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="25sp"
                android:password="true"
                android:singleLine="true"
                android:inputType="textPassword" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="60"
                android:background="#c8e7ff"
                android:minWidth="25px"
                android:minHeight="25px"
                android:orientation="horizontal"
                android:paddingBottom="2dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                >
                <Button
                    android:text="@string/Main_Login_Konec"
                    android:nextFocusDown="@id/btn_Login_Konec_V2"
                    android:nextFocusLeft="@id/btn_Login_Konec_V2"
                    android:nextFocusUp="@id/edittext_Login_PWD_V2"
                    android:nextFocusRight="@id/btn_Login_Logins_V2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="20"
                    android:id="@+id/btn_Login_Konec_V2"
                    android:paddingBottom="2dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <Button
                    android:text= "@string/Main_Login_Uzivatele"
                    android:nextFocusDown="@id/btn_Login_Logins_V2"
                    android:nextFocusLeft="@id/btn_Login_Konec_V2"
                    android:nextFocusUp="@id/edittext_Login_PWD_V2"
                    android:nextFocusRight="@id/btn_Login_OK_V2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="20"
                    android:id="@+id/btn_Login_Logins_V2"
                    android:paddingBottom="2dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
                <Button
                    android:text="@string/Main_Login_OK"    
                    android:nextFocusDown="@id/btn_Login_OK_V2"
                    android:nextFocusLeft="@id/btn_Login_Logins_V2"
                    android:nextFocusUp="@id/edittext_Login_PWD_V2"
                    android:nextFocusRight="@id/btn_Login_OK_V2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="20"
                    android:id="@+id/btn_Login_OK_V2"
                    android:paddingBottom="2dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>


</LinearLayout>