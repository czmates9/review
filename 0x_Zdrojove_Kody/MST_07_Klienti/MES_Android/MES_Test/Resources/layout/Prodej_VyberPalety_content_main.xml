<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
     android:background="#c9c9c9"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/Prodej_VyberPalety_app_bar_main">
        <TextView
        android:text="@string/Prodej_VyberPalety_Label_1"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Prodej_VyberPalety_txt_1"
        android:textSize="50px"
        android:textAlignment="center"
        />
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:weightSum="100"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        >
            <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Prodej_VyberPalety_edittxt_1"
            android:nextFocusDown="@id/Prodej_VyberPalety_btn_VyberTyp"
            android:nextFocusLeft="@id/Prodej_VyberPalety_edittxt_1"
            android:nextFocusUp="@id/Prodej_VyberPalety_edittxt_1"
            android:nextFocusRight="@id/Prodej_VyberPalety_edittxt_1"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="50px"
            android:singleLine="true"
            android:inputType="text" 
            android:hint="@string/Prodej_VyberPalety_hint1"
            android:layout_weight="90"
            />
            <Button
            android:text="@string/Prodej_VyberPalety_VyberTyp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/Prodej_VyberPalety_btn_VyberTyp" 
            android:layout_weight="10"
            android:textColor="#000000"
            android:textSize="20px"
            android:nextFocusDown="@id/Prodej_VyberPalety_edittxt_2"
            android:nextFocusRight="@id/Prodej_VyberPalety_btn_VyberTyp"
            android:nextFocusUp="@id/Prodej_VyberPalety_edittxt_1"
            android:nextFocusLeft="@id/Prodej_VyberPalety_btn_VyberTyp"
            />
        </LinearLayout>
        
        <TextView
        android:text="@string/Prodej_VyberPalety_Label_2"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Prodej_VyberPalety_txt_2"
        android:textSize="50px"
        android:textAlignment="center"
        />
        
        <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Prodej_VyberPalety_edittxt_2"
        android:nextFocusDown="@id/Prodej_VyberPalety_btn_OK"
        android:nextFocusLeft="@id/Prodej_VyberPalety_edittxt_2"
        android:nextFocusUp="@id/Prodej_VyberPalety_btn_VyberTyp"
        android:nextFocusRight="@id/Prodej_VyberPalety_edittxt_2"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="50px"
        android:singleLine="true"
        android:inputType="number"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:hint="@string/Prodej_VyberPalety_hint2"
        />
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="100"
         android:background="#c8e7ff"
        >
        <Button
        android:text="@string/Prodej_VyberPalety_Storno"    
        android:nextFocusDown="@id/Prodej_VyberPalety_btn_Storno"
        android:nextFocusLeft="@id/Prodej_VyberPalety_btn_Storno"
        android:nextFocusUp="@id/Prodej_VyberPalety_edittxt_2"
        android:nextFocusRight="@id/Prodej_VyberPalety_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/Prodej_VyberPalety_btn_Storno"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        <Button
        android:text="@string/Prodej_VyberPalety_OK"    
        android:nextFocusDown="@id/Prodej_VyberPalety_btn_OK"
        android:nextFocusLeft="@id/Prodej_VyberPalety_btn_Storno"
        android:nextFocusUp="@id/Prodej_VyberPalety_edittxt_2"
        android:nextFocusRight="@id/Prodej_VyberPalety_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/Prodej_VyberPalety_btn_OK"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        </LinearLayout>
</LinearLayout>