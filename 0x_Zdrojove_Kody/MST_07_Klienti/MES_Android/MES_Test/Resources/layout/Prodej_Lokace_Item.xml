<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/Prodej_Lokace_LL"
    android:weightSum="100"
        android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    >
    <TextView
        android:id="@+id/Prodej_Lokace_LOCNCODE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#333333"
        android:textSize="40px"
        android:text="@string/Def_Text"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginLeft="4dp"
        android:layout_weight="50"
        android:layout_margin="5dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="50"
        android:weightSum="200"
        >
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#000"
                android:textSize="20px"
                android:text="@string/Def_Text"
                android:id="@+id/Prodej_Lokace_desc"
                android:layout_weight="50"
                android:layout_margin="2dp"
            android:paddingLeft="20dp"
                />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#000"
                android:textSize="20px"
                android:text="@string/Def_Text"
                android:id="@+id/Prodej_Lokace_SKL_ID"
                android:layout_weight="50"
                android:layout_margin="2dp"
            android:paddingLeft="20dp"
                />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#000"
                android:textSize="20px"
                android:text="@string/Def_Text"
                android:id="@+id/Prodej_Lokace_BarCode"
                android:layout_weight="50"
                android:layout_margin="2dp"
            android:paddingLeft="20dp"
                />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#000"
                android:textSize="20px"
                android:text="@string/Def_Text"
                android:id="@+id/Prodej_Lokace_Type"
                android:layout_weight="50"
                android:layout_margin="2dp"
            android:paddingLeft="20dp"
                />
        </LinearLayout>
</LinearLayout>
