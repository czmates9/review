<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
     android:background="#c9c9c9"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/UserLoginWithTimeInput_app_bar_main">
    <TextView
        android:text="@string/UserLoginWithTimeInput_TextOkna"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:layout_marginBottom="30px"
        android:paddingTop="40px"
        android:paddingBottom="40px"
        />
    <TextView
        android:text="@string/UserLoginWithTimeInput_DefText"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/UserLoginWithTimeInput_txt_Date" />
            <Button
        android:text="@string/UserLoginWithTimeInput_Date"    
        android:nextFocusDown="@id/UserLoginWithTimeInput_btn_Time"
        android:nextFocusLeft="@id/UserLoginWithTimeInput_btn_Date"
        android:nextFocusUp="@id/UserLoginWithTimeInput_btn_Date"
        android:nextFocusRight="@id/UserLoginWithTimeInput_btn_Date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/UserLoginWithTimeInput_btn_Date"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        <TextView
        android:text="@string/UserLoginWithTimeInput_DefText"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/UserLoginWithTimeInput_txt_Time" />
                <Button
        android:text="@string/UserLoginWithTimeInput_Time"    
        android:nextFocusDown="@id/UserLoginWithTimeInput_btn_OK"
        android:nextFocusLeft="@id/UserLoginWithTimeInput_btn_Time"
        android:nextFocusUp="@id/UserLoginWithTimeInput_btn_Date"
        android:nextFocusRight="@id/UserLoginWithTimeInput_btn_Time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/UserLoginWithTimeInput_btn_Time"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="100"
        >
        <Button
        android:text="@string/UserLoginWithTimeInput_Storno"    
        android:nextFocusDown="@id/UserLoginWithTimeInput_btn_Storno"
        android:nextFocusLeft="@id/UserLoginWithTimeInput_btn_Storno"
        android:nextFocusUp="@id/UserLoginWithTimeInput_btn_Time"
        android:nextFocusRight="@id/UserLoginWithTimeInput_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/UserLoginWithTimeInput_btn_Storno"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        <Button
        android:text="@string/UserLoginWithTimeInput_OK"    
        android:nextFocusDown="@id/UserLoginWithTimeInput_btn_OK"
        android:nextFocusLeft="@id/UserLoginWithTimeInput_btn_Storno"
        android:nextFocusUp="@id/UserLoginWithTimeInput_btn_Time"
        android:nextFocusRight="@id/UserLoginWithTimeInput_btn_OK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="50"
        android:id="@+id/UserLoginWithTimeInput_btn_OK"
        android:paddingBottom="2dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:layout_gravity="center_vertical" />
        </LinearLayout>
</LinearLayout>