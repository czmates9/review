<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/prodejdavka_border"
    >
    <TextView
        android:id="@+id/Prodej_TypDokladu_Doc_Desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#333333"
        android:textSize="45px"
        android:text="@string/Def_Text"
        android:layout_gravity="center_horizontal"
        android:textAlignment="center"
        android:layout_marginLeft="4dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="100"
        >
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#F00"
        android:textSize="20px"
        android:text="@string/Def_Text"
        android:id="@+id/Prodej_TypDokladu_Item_Doc_Carcode"
        android:layout_weight="25"
            />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#F00"
        android:textSize="20px"
        android:text="@string/Def_Text"
        android:id="@+id/Prodej_TypDokladu_Item_Doc_ID"
        android:layout_weight="25"
            />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#F00"
        android:textSize="20px"
        android:text="@string/Def_Text"
        android:id="@+id/Prodej_TypDokladu_Item_Doc_ID2"
            android:layout_weight="25"
            />
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#F00"
        android:textSize="20px"
        android:text="@string/Def_Text"
        android:id="@+id/Prodej_TypDokladu_Item_Doc_Typ"
            android:layout_weight="25"
            />
        </LinearLayout>
</LinearLayout>
