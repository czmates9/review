<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
     android:background="#c9c9c9"
    android:weightSum="100"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/OdvadeniVyroby_app_bar_main">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#c9c9c9"
        android:weightSum="100"
        android:layout_weight="50"
        android:orientation="horizontal"
        >
        <Button
            android:text="@string/btn_Odvadeni"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/btn_OV_Odvadeni" 
            android:background="#CD5C5C"
            android:layout_weight="50"
            android:layout_margin="10px"
            android:textSize="40px"                    
            android:nextFocusDown="@id/btn_OV_Korekce"
            android:nextFocusLeft="@id/btn_OV_Odvadeni"
            android:nextFocusUp="@id/btn_OV_Odvadeni"
            android:nextFocusRight="@id/btn_OV_Tisk"
            />
        <Button
            android:text="@string/btn_Tisk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/btn_OV_Tisk" 
            android:background="#F0E68C"
            android:layout_weight="50"
            android:layout_margin="10px"
            android:textSize="40px"
            android:nextFocusDown="@id/btn_OV_Udalosti"
            android:nextFocusLeft="@id/btn_OV_Odvadeni"
            android:nextFocusUp="@id/btn_OV_Tisk"
            android:nextFocusRight="@id/btn_OV_Tisk"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#c9c9c9"
        android:weightSum="100"
        android:layout_weight="50"
        android:orientation="horizontal"
        >
        <Button
            android:text="@string/btn_Korekce"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/btn_OV_Korekce" 
            android:background="#BC8F8F"
            android:layout_weight="50"
            android:layout_margin="10px"
            android:textSize="40px"
            android:nextFocusDown="@id/btn_OV_Korekce"
            android:nextFocusLeft="@id/btn_OV_Korekce"
            android:nextFocusUp="@id/btn_OV_Odvadeni"
            android:nextFocusRight="@id/btn_OV_Udalosti"            
            />
        <Button
            android:text="@string/btn_Udalosti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/btn_OV_Udalosti"
            android:background="#66CDAA"
            android:layout_weight="50"
            android:layout_margin="10px"
            android:textSize="40px"
            android:nextFocusDown="@id/btn_OV_Udalosti"
            android:nextFocusLeft="@id/btn_OV_Korekce"
            android:nextFocusUp="@id/btn_OV_Tisk"
            android:nextFocusRight="@id/btn_OV_Udalosti"            
            />
    </LinearLayout>


</LinearLayout>