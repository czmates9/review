   providerName="Microsoft.SqlServerCe.Client.3.5" />
  <add name="ProductionConnectionString" connectionString="Data Source=d:\_work_\_Vyvoj_Subversion_01\Vyroba\Vyroba_Server\SqlCE\Production.sdf"
   providerName="Microsoft.SqlServerCe.Client.3.5" />
  <add name="VyrobaCEConnectionString1" connectionString="Data Source=D:\_work_\_Vyvoj_Subversion_01\Vyroba\Vyroba_Server\SqlCE\VyrobaCE.sdf"
   providerName="Microsoft.SqlServerCe.Client.3.5" />
