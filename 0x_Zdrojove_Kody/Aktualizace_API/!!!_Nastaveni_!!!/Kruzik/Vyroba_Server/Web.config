    <!-- Logovani informaci, chyb a datovych souboru -->
		<add key="ErrorDataFileDirectory" value=".\Logs\ErrorDataFileDirectory"/>
		<add key="ProcessedDataFileDirectory" value=".\Logs\ProcessedDataFileDirectory"/>
		<add key="ErrorLogFile" value="..\Logs\log.txt"/>
		<!-- Dohledovani chyb odvadeni, odesilaji se emailem zpravy o chybach pri zpracovani, pokud nastane -->
		<add key="DohledSMTP" value="false"/>
		<add key="DohledSMTPHlavicka" value="Vyvoj Test"/>
		<add key="DohledSMTPServer" value="mail.ceskyserver.cz"/>
		<add key="DohledSMTPFromAddress" value="dohled@fask.cz"/>
		<add key="DohledSMTPToAddress" value="vyvoj@fask.cz"/>
		<add key="ApplicationEndPass" value="1"/>
    <!--
    Kontrolni funkce pro odvadeni vzhledem ke stroji. true - uzivatel muze soucasne odvadet na vice strojich, false - nemuze (defaultne se pouziva true)
    -->
    <add key="AllowUserProductionOnMoreMachines" value="true"/>
    <!-- Odvadeni pouze v hlavnim vlakne (kvuli navratove hodnote) -->
    <add key="ProcessProductionDataMainThread" value="true"/>

    <!-- Tasks after update action 
      jestlize je value prazdna, pak se akce neprovadi ... 
      parametr1: value=<nazev parametru1> NVarChar(20) - ID Ukolu Uzivatele, ktere bylo modifikovano
      chyba je pouze zalogovana na serveru, ale data zustavaji ulozeny v db...
      <add key="Tasks_AfterDataProcessed_Action" value="fask_tasks_afteraction" />
	  -->
    <add key="Tasks_AfterDataProcessed_Action" value="" />
    <add key="Tasks_AfterDataProcessed_Action_P1" value="@ukolid" />
    <add key="Tasks_AfterDataProcessed_Action_Asynchronous" value="false" />
  </appSettings>
	<connectionStrings>
