<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>localization</Title>
			<Shortcut>localization</Shortcut>
			<Description>Code snippet for Localization static property</Description>
			<Author>FASK, spol. s r.o.</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Declarations>
				<Literal>
					<ID>name</ID>
					<ToolTip>Property name</ToolTip>
					<Default>MyProperty</Default>
				</Literal>
        <Literal>
          <ID>description</ID>
          <ToolTip>Property description</ToolTip>
          <Default>MyProperty</Default>
        </Literal>
			</Declarations>
			<Code Language="csharp">
          <![CDATA[
        /// <summary>
        /// $description$
        /// </summary>
        public static string $name$
        {
            get 
            { 
              return GetDataByKey("$name$", resourceCulture); 
            }
        }
	$end$]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>