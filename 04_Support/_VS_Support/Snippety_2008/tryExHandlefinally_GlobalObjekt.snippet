<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets  xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>tryExHandlefinally_GlobalObjekt</Title>
			<Shortcut>tryExHandle</Shortcut>
			<Description>Code snippet for try catch + Handle + GlobalObjekt</Description>
			<Author>FASK Tadeas Divacky</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
				<SnippetType>SurroundsWith</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="csharp"><![CDATA[try 
	{

	if (this.globalObject == null)
		this.globalObject = new GlobalObject();
	else
		throw new Exception("GlobalObjekt Zlobí...");
	        
		$selected$
	}
	catch (System.Exception ex)
	{
		MessageBox.Show(ex.Message, this.Text, MessageBoxButtons.OK, MessageBoxIcon.Asterisk, MessageBoxDefaultButton.Button1);
                Logging.Log.Write(ex);
	}
	finally
	{
	this.globalObject.Dispose();
	this.globalObject = null;
	}$end$]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>